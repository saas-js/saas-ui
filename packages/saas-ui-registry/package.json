{
  "name": "@saas-ui/registry",
  "version": "0.2.0-next.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Shared Saas UI registry protocol and schemas",
  "exports": {
    ".": {
      "sui": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "sui": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./auth": {
      "sui": "./src/auth.ts",
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "require": "./dist/auth.cjs"
    },
    "./compiler": {
      "sui": "./src/compiler/index.ts",
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js",
      "require": "./dist/compiler/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts src/auth.ts src/compiler/index.ts --config tsup.config.ts",
    "clean": "rimraf --no-glob ./dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "ts-morph": "^26.0.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.53.3",
    "@types/node": "^24.0.4",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.2"
  },
  "peerDependencies": {
    "ts-morph": "^26.0.0"
  },
  "peerDependenciesMeta": {
    "ts-morph": {
      "optional": true
    }
  }
}
