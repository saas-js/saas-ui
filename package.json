{
  "name": "saas-ui",
  "description": "The frontend stack for SaaS companies",
  "private": true,
  "type": "module",
  "author": "Eelco Wiersma <eelco@appulse.nl>",
  "license": "MIT",
  "homepage": "https://saas-ui.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/saas-js/saas-ui"
  },
  "keywords": [
    "saas-ui",
    "react",
    "ui",
    "chakra-ui",
    "design-system",
    "react-components",
    "uikit",
    "accessible",
    "components",
    "emotion",
    "library"
  ],
  "storybook": {
    "title": "Saas UI",
    "url": "https://storybook.saas-ui.dev"
  },
  "scripts": {
    "w": "pnpm --filter",
    "dev:web": "pnpm --filter website dev",
    "dev:palette": "pnpm --filter palette-docs dev",
    "changelog:gen": "tsx scripts/changelog-generate.ts",
    "changelog:write": "tsx scripts/changelog-write.ts",
    "changelog:commit": "git add CHANGELOG.md && git commit -am 'docs: add changelog' && git push",
    "changeset:rc": "pnpm changeset pre enter rc",
    "changeset:version": "changeset version",
    "publish:rc": "pnpm --filter '@saas-ui/*' publish --access public --tag rc --publish-branch v3 --no-git-checks && pnpm changeset tag --no-git-checks",
    "publish": "pnpm --filter '@saas-ui/*' publish --no-git-checks && pnpm changeset tag --no-git-checks",
    "storybook": "pnpm --filter saas-ui-storybook dev",
    "build:storybook": "pnpm --filter saas-ui-storybook build",
    "prepare": "husky install && pnpm registry:prepare",
    "clean": "turbo run clean",
    "test": "vitest",
    "test:watch": "vitest --watch --onlyChanged",
    "test:ci": "vitest --color --run",
    "registry:generate": "tsx --conditions=sui tooling/registry/generate.ts",
    "registry:prepare": "pnpm registry:generate",
    "registry:dev": "tsx --conditions=sui tooling/registry/watch.ts",
    "registry:check": "tsx --conditions=sui tooling/registry/check.ts",
    "registry:legacy-check": "tsx --conditions=sui tooling/registry/legacy-check.ts",
    "registry:typecheck": "pnpm exec tsc --noEmit --project apps/website/registry/default/registry-contracts.types.tsconfig.json && pnpm exec tsc --noEmit --project apps/website/registry/default/setup/provider-variants.types.tsconfig.json && pnpm exec tsc --noEmit --project apps/website/registry/default/ui/sidebar/sidebar.types.tsconfig.json",
    "registry:test": "pnpm --filter @saas-ui/registry test && vitest run --config tooling/registry/vitest.config.ts",
    "registry:icons": "pnpm --filter website registry:icons",
    "registry:ci": "pnpm registry:prepare && pnpm registry:check && pnpm registry:legacy-check && pnpm registry:typecheck && pnpm registry:test && pnpm --filter @saas-ui/cli test:prepared && pnpm registry:cli:acceptance:prepared && pnpm registry:consumer:packed:acceptance:prepared && pnpm registry:dogfood:check:prepared && pnpm registry:consumer:install-all:acceptance:prepared",
    "registry:dogfood:check": "pnpm registry:generate && pnpm registry:dogfood:check:prepared",
    "registry:dogfood:check:prepared": "pnpm registry:cli:local:prepared -- diff --check --cwd apps/website --yes && pnpm registry:cli:local:prepared -- diff --check --cwd apps/compositions --yes",
    "registry:cli:acceptance": "pnpm registry:generate && pnpm registry:cli:acceptance:prepared",
    "registry:cli:acceptance:prepared": "pnpm --filter @saas-ui/cli build && tsx --conditions=sui tooling/registry/built-cli-acceptance.ts",
    "registry:retirement:preflight": "tsx --conditions=sui tooling/registry/retirement-preflight.ts",
    "registry:retirement:check": "pnpm registry:ci && pnpm registry:retirement:preflight",
    "registry:retirement:packed-release": "tsx --conditions=sui tooling/registry/packed-release-gate.ts",
    "registry:retirement:version-availability": "tsx --conditions=sui tooling/registry/published-version-gate.ts --planned-if-pending",
    "registry:release": "pnpm registry:ci && pnpm registry:retirement:preflight && pnpm registry:retirement:version-availability && pnpm registry:prepare && pnpm registry:release:bundle",
    "registry:release:bundle": "tsx --conditions=sui tooling/registry/release-bundle.ts",
    "registry:consumer:test": "pnpm registry:generate && pnpm registry:consumer:test:prepared",
    "registry:consumer:test:prepared": "pnpm --filter @saas-ui/cli test:consumer:prepared",
    "registry:consumer:install-all:test": "pnpm registry:generate && pnpm registry:consumer:install-all:test:prepared",
    "registry:consumer:install-all:test:prepared": "pnpm --filter @saas-ui/cli test:consumer:install-all:prepared",
    "registry:consumer:acceptance": "pnpm registry:generate && pnpm registry:consumer:acceptance:prepared",
    "registry:consumer:acceptance:prepared": "pnpm --filter @saas-ui/cli test:consumer:acceptance:prepared",
    "registry:consumer:install-all:acceptance": "pnpm registry:generate && pnpm registry:consumer:install-all:acceptance:prepared",
    "registry:consumer:install-all:acceptance:prepared": "pnpm --filter @saas-ui/cli test:consumer:install-all:acceptance:prepared",
    "registry:consumer:packed:acceptance": "pnpm registry:generate && pnpm registry:consumer:packed:acceptance:prepared",
    "registry:consumer:packed:acceptance:prepared": "pnpm --filter @saas-ui/appearance --filter @saas-ui/chakra-preset --filter @saas-ui/react --filter @saas-ui/hooks --filter @saas-ui/cli build && tsx --conditions=sui tooling/registry/packed-consumer-acceptance.ts",
    "registry:cli:local": "pnpm registry:generate && pnpm registry:cli:local:prepared",
    "registry:cli:local:prepared": "tsx --conditions=sui packages/saas-ui-cli/scripts/run-local-registry.ts",
    "test:e2e": "pnpx playwright test",
    "test:e2e:ui": "pnpx playwright test --ui",
    "test:e2e:headed": "pnpx playwright test --headed",
    "lint": "turbo run lint",
    "lint:staged": "lint-staged --allow-empty --config lint-staged.config.js",
    "create:pkg": "hygen package chakra-component",
    "create:block": "pnpm hygen blocks new",
    "build:web": "pnpm --filter website build",
    "build:theme": "turbo run build --filter='./packages/saas-ui-theme'",
    "build:panda": "turbo run build",
    "build:tokens": "chakra typegen packages/saas-ui-chakra-preset/src/index.ts",
    "build:tokens-dev": "cross-env LOCAL=1 chakra typegen packages/saas-ui-chakra-preset/src/index.ts",
    "build:packages": "turbo run build --filter='./packages/saas-ui-*' --concurrency=5 --continue --env-mode=loose",
    "build:packages:force": "turbo run build --filter='./packages/saas-ui-*' --concurrency=5 --continue --force --env-mode=loose",
    "watch:theme": "turbo run build --filter='./packages/saas-ui-theme' -- --watch",
    "clean:packages": "turbo run clean",
    "build:storybook-addon": "pnpm --filter @saas-ui/storybook-addon build",
    "build:props-docs": "pnpm typedocs && pnpm --filter @saas-ui/props-docs build",
    "typedocs": "tsx scripts/typedocs.ts",
    "preinstall": "rm -rf node_modules/odiff-bin",
    "release": "pnpm run changeset:version && pnpm run build:packages && pnpm run build:tokens && pnpm run registry:retirement:packed-release && pnpm run publish:rc"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.36.1",
    "@changesets/cli": "^2.29.7",
    "@manypkg/get-packages": "^3.1.0",
    "@saas-ui/chakra-preset": "workspace:*",
    "@octokit/rest": "^22.0.0",
    "@playwright/test": "^1.58.2",
    "@saas-ui/registry": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.0.4",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@playwright/mcp": "^0.0.68",
    "browserslist": "^4.26.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-storybook": "^10.2.0",
    "framer-motion": "^12.23.22",
    "husky": "^9.1.7",
    "hygen": "^6.2.11",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.3",
    "next": "^16.3.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "vitest": "^3.2.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.2"
}
