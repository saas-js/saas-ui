{
  "name": "website",
  "version": "0.1.1-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm registry:generate && concurrently --kill-others-on-fail --names registry,next \"pnpm registry:dev -- --skip-initial\" \"next dev --turbopack --port 3020\"",
    "prebuild": "pnpm registry:generate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "node scripts/validate-content.mjs && tsc --noEmit",
    "test:content": "node scripts/validate-content.mjs",
    "types:ark": "pnpm tsx scripts/types/ark.ts",
    "types:recipe": "pnpm tsx scripts/types/recipe.ts",
    "types:component": "pnpm tsx scripts/types/component.ts",
    "generate:composition": "pnpm tsx scripts/composition.ts",
    "generate:types": "pnpm types:ark && pnpm types:recipe && pnpm types:component",
    "generate:icon": "pnpm tsx scripts/generate-icon.ts",
    "registry:generate": "pnpm --dir ../.. registry:generate",
    "registry:dev": "pnpm --dir ../.. registry:dev",
    "registry:icons": "pnpm tsx scripts/generate-registry-icons.ts"
  },
  "dependencies": {
